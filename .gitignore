# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.vite/
.turbo/

# Coverage and test output
coverage/
*.lcov
.nyc_output/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Angular artifacts
.angular/
packages/ng-elements/dist/
# ng-elements bundle is copied into the shell's public/ at build time
packages/shell/public/ng-elements/

# Editor and IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.cache/
*.tsbuildinfo
mockup/

# Local dev sitemap — untracked by intent
packages/shell/public/sitemap.html

# Architecture writeup + next-chat continuation prompt — local-only meta-docs.
# Phase 8 may decide to track ARCHITECTURE.md and link it from the colophon page.
ARCHITECTURE.md
CONTINUE.md
AGENTS.md
CLAUDE.md
CURRENT.md

# Local debugging screenshots from Playwright/Puppeteer runs. Useful for
# verifying behavior without a real browser; never committed.
.screenshots/

# Local source-master staging area for asset-prep scripts (e.g. nebula
# imagery before it's resized + WebP-encoded into committed textures).
# Contents are inputs to scripts/build-*.mjs scripts; the emitted
# outputs ARE committed under packages/celestial/src/textures/.
.scratch/

# Claude Code session state (date-stamped flags written by .claude/hooks/).
.claude/state/

.dump/
# Generated resume (renamed from source PDF by prebuild script)
packages/shell/public/resume.pdf

# a11y audit output
a11y-report/
