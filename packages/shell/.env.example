# Phase 6 environment variables. Copy to .env.local and fill in to enable
# the features that depend on third-party services. The shell renders hint
# cards in place of any feature whose env var is unset, so you can develop
# locally without all of them configured.

# Optional. Override the Vite base path. Default '/'.
VITE_BASE_URL=/

# MapTiler API key for /contact's MapLibre map. Free tier is sufficient.
# https://www.maptiler.com/cloud/account/keys/
VITE_MAPTILER_KEY=

# Cloudflare Turnstile site key for the bot-mitigation gate on /contact.
# https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=

# Calendly inline-embed URL (full https://calendly.com/...).
# https://help.calendly.com/hc/en-us/articles/223147027
VITE_CALENDLY_URL=
