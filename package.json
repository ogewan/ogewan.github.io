{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Polyglot portfolio SPA — React 19 + R3F + Angular Elements + MapLibre",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@portfolio/shell\" --filter \"@portfolio/ng-elements\" run \"/^(dev|build:watch)$/\"",
    "dev:shell": "pnpm --filter @portfolio/shell dev",
    "build": "pnpm --filter @portfolio/ng-elements build && pnpm --filter @portfolio/shell build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:visual": "node scripts/visual-test.mjs",
    "capture:scenes": "node scripts/capture-scenes.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "playwright": "^1.59.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
